rules_version = '2';

// -----------------------------------------------------------------------------
// SarvaCart — Firestore Security Rules
//
// Role model:
//   - Admin: request.auth.token.admin == true   (set via custom claims)
//   - Owner: document id == request.auth.uid    (or userId field matches)
//
// Collection access summary:
//   users        -> own doc read/write; admins full access
//   products     -> read by everyone; write by admins
//   categories   -> read by everyone; write by admins
//   orders       -> read by owner or admin; create by owner; status update by admin
//   cart         -> own doc read/write; admins full access
//   wishlist     -> own doc read/write; admins full access
//   addresses    -> own doc read/write; admins full access
//   settings     -> read by everyone; write by admins
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------- helpers -------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerDoc() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

// ----------------------------- users --------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user";
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "phone", "address", "avatarUrl", "onboarded"]));
      allow delete: if isAdmin();
    }

    // ----------------------------- products -----------------------------
    match /products/{productId} {
      // Public read: only approved and active products visible to everyone
      allow read: if true;
      // Sellers can create their own products (status defaults to pending)
      allow create: if isSignedIn() && (
        (request.auth.token.role == "seller"
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status == "pending")
        || isAdmin()
      );
      // Sellers can update their own products; admins can update any
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.token.role == "seller"
          && request.auth.uid == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "description", "brand", "category", "price",
              "discountPrice", "images", "sizes", "colors", "stock",
              "rating", "reviewCount", "tags", "featured", "active",
              "status", "rejectionReason"]));
      );
      // Sellers can delete their own products; admins can delete any
      allow delete: if isSignedIn() && (
        isAdmin()
        || (request.auth.token.role == "seller"
          && request.auth.uid == resource.data.sellerId)
      );
    }

    // ----------------------------- categories ---------------------------
    match /categories/{categoryId} {
      allow read: if true;                 // everyone can read
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------- orders -------------------------------
    match /orders/{orderId} {
      allow read: if isSignedIn() && (isAdmin() || isOwnerDoc());
      // Orders are created only by placeCodOrder, which recomputes prices and
      // reserves stock in a trusted transaction. The callable uses Admin SDK.
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && request.resource.data.status in [
          "Pending Confirmation", "Pending", "Processing", "Packed",
          "Picked Up", "In Transit", "Out For Delivery", "Shipped",
          "Delivered", "Cancelled"
        ];
      allow delete: if isAdmin();
    }

    // ----------------------------- cart ---------------------------------
    match /cart/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    // ----------------------------- wishlist -----------------------------
    match /wishlist/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    // ----------------------------- addresses ----------------------------
    match /addresses/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    // ----------------------------- settings -----------------------------
    match /settings/{settingId} {
      allow read: if true;                 // everyone can read
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------- sellers ------------------------------
    match /sellers/{sellerId} {
      allow read: if isSignedIn();         // everyone signed in can read
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.role == "seller";  // role set in users doc
      allow update: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    // ----------------------------- sellerKyc ----------------------------
    match /sellerKyc/{kycId} {
      allow read: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.sellerId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.sellerId;
      allow update: if isAdmin();          // only admin can approve/reject
      allow delete: if isAdmin();
    }

    // ----------------------------- commissions --------------------------
    match /commissions/{commissionId} {
      allow read: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.sellerId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.sellerId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------- returns ------------------------------
    match /returns/{returnId} {
      allow read: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.userId
        || request.auth.token.role == "seller"
        && request.auth.uid == resource.data.sellerId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.token.role == "seller"
          && request.auth.uid == resource.data.sellerId)
      );
      allow delete: if isAdmin();
    }

    // ----------------------------- coupons ------------------------------
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------- couponUsage --------------------------
    match /couponUsage/{usageId} {
      allow read: if isSignedIn() && (
        isAdmin() || request.auth.uid == resource.data.userId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------- reviews ------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn()
        && (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // ----------------------------- wishlists ----------------------------
    match /wishlists/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ----------------------------- banners ------------------------------
    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
