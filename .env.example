# =============================================================================
# SarvaCart — Environment Variables
# =============================================================================
#
# Copy this file to `.env.local` for local development, or set the equivalent
# variables in your hosting provider (Vercel / Netlify / Firebase Hosting).
#
#   cp .env.example .env.local
#
# The app runs entirely on localStorage when Firebase is NOT configured, so a
# missing `.env.local` will NOT crash the build. Add the Firebase vars below to
# enable the real backend (Firestore + Auth + Storage sync via the repository
# layer in `src/services/repository.ts`).
#
# =============================================================================
# 1) FIREBASE CLIENT CONFIG  (required for the browser app)
# -----------------------------------------------------------------------------
# Obtained from: Firebase console -> Project settings -> General -> Your apps
# -> SDK setup and configuration.
# =============================================================================
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# Optional: shown in the Firebase console next to "Web app configuration".
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# 2) FIREBASE SERVICE ACCOUNT  (required ONLY for server-side scripts)
# -----------------------------------------------------------------------------
# Used by the seed & admin-bootstrap scripts (`npm run seed`, `npm run seed:admin`).
# NEVER include this in the frontend bundle — it grants full admin access.
#
# Option A — path to a service-account JSON file downloaded from:
#   Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
#
# Option B — inline JSON (escape quotes). Example:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
#
# NOTE: The service account JSON already contains `project_id`, so
# `VITE_FIREBASE_PROJECT_ID` above is only used as a fallback.
# =============================================================================

# =============================================================================
# 3) RAZORPAY  (used by Cloud Functions only — NEVER expose the secret)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# =============================================================================
# 4) DELHIVERY  (used by Cloud Functions only — NEVER expose the token)
# -----------------------------------------------------------------------------
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=your-delhivery-token
# =============================================================================
